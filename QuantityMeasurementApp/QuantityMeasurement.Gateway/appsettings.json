{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "authCluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "quantity": {
        "ClusterId": "quantityCluster",
        "Match": {
          "Path": "/api/quantity/{**catch-all}"
        }
      },
      "history": {
        "ClusterId": "historyCluster",
        "Match": {
          "Path": "/api/history/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "authCluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5179/"
          }
        }
      },

      "quantityCluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5090/"
          }
        }
      },

      "historyCluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5053/"
          }
        }
      }
    }
  }
}